# ============================================================
# QAX Real Experience · Plantilla de .env
# ============================================================
# Copia este archivo a `.env` y completa los valores.
# NUNCA commitees el `.env` con valores reales. Ya está ignorado
# por .gitignore. Ver README > Manejo de KEYS.
#
# Origen de los valores:
#   - Para APIs: la documentación Swagger del API (base URL, tokens,
#     ejemplos de requests). NO se obtienen en un dashboard externo.
#   - Para Web: el dominio de staging del producto objetivo.
#   - Para TEST_USER_EMAIL: un servicio de email temporal/temp-mail.org
#     (o cualquier servicio de email temporal gratuito).
# Los valores de abajo son PLACEHOLDERS de guía, no valores reales.
# ============================================================

# ---- Base URLs ----
# Base URL del API objetivo. Obtener del Swagger del API.
# Placeholder de ejemplo:
BASE_URL_API=https://api.example.com

# Base URL de la app Web objetivo (staging).
# Placeholder de ejemplo del dominio de staging del producto:
BASE_URL_WEB=https://stg.qaxpert.com

# ---- Autenticación API ----
# Token Bearer usado por apiHelper en el header Authorization.
# Obtenerlo del Swagger del API. Placeholder de ejemplo:
API_TOKEN=bearer-token-de-ejemplo

# ---- Usuario de prueba ----
# Email temporal para usuarios de prueba (temp-mail.org o similar).
# Evita spam a cuentas reales y da aislamiento/desechabilidad.
# Placeholder de ejemplo:
TEST_USER_EMAIL=tempmail+1@temp-mail.org

# Contraseña usada para usuarios dinámicos creados por dataBuilder.
TEST_USER_PASSWORD=