# ============================================================
# QAX Real Experience · Plantilla de .env
# ============================================================
# Copia este archivo a `.env` y completa los valores.
# NUNCA commitees el `.env` con valores reales. Ya está ignorado
# por .gitignore. Ver README > Manejo de KEYS.
# ============================================================

# ---- Supabase ----
# Project URL (Dashboard > Settings > API). Formato: https://<ref>.supabase.co
SUPABASE_URL=

# anon public key (Dashboard > Settings > API). Segura para el cliente.
SUPABASE_ANON_KEY=

# service_role key (Dashboard > Settings > API). NUNCA exponer en cliente.
# Requerida para fixtures E2E que crean usuarios por API.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Base URLs por dominio ----
# API REST de Supabase (normalmente = SUPABASE_URL).
BASE_URL_API=

# URL de la app Web (QAX-TERMINAL local: http://localhost:5173).
BASE_URL_WEB=

# ---- Usuario de prueba ----
# Email del usuario preexistente (opcional, para smoke de login UI).
TEST_USER_EMAIL=
# Contraseña usada para usuarios dinámicos creados por dataBuilder.
TEST_USER_PASSWORD=

# ---- Opcional ----
# API token genérico si la app objetivo lo requiere.
API_TOKEN=