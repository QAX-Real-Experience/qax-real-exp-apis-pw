    {
      "name": "US2 - Login de aprendiz cero",
      "item": [
        {
          "name": "Login exitoso",
          "request": {
            "description": "Usar email y password de un aprendiz ya registrado. Copiar el access_token de la respuesta para usarlo en Validar usuario autenticado.",
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json;charset=UTF-8"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-client-info",
                "value": "supabase-js/2.112.3; runtime=web"
              },
              {
                "key": "x-supabase-api-version",
                "value": "2024-01-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"gotrue_meta_security\": {}\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/v1/token?grant_type=password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          }
        },
        {
          "name": "Validar usuario autenticado",
          "request": {
            "description": "Pegar en access_token el token obtenido en Login exitoso.",
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabase_anon_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/v1/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "v1",
                "user"
              ]
            }
          }
        },
