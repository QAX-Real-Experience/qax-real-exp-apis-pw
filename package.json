{
  "name": "qax-real-exp-playwirght",
  "version": "2.0.0",
  "description": "Repositorio base de automatización funcional APIs + Web + E2E con Playwright y TypeScript para QAX Real Experience.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:apis": "playwright test --project=apis",
    "test:web": "playwright test --project=web",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:grep": "playwright test --grep",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "list": "playwright test --list"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "web-testing",
    "e2e",
    "test-automation",
    "qa-automation",
    "qax-real-experience",
    "qaxpert"
  ],
  "author": "QAXpert",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.2",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QAX-Real-Experience/qax-real-exp-playwirght.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/QAX-Real-Experience/qax-real-exp-playwirght/issues"
  },
  "homepage": "https://github.com/QAX-Real-Experience/qax-real-exp-playwirght#readme",
  "dependencies": {
    "@faker-js/faker": "^10.4.0"
  }
}